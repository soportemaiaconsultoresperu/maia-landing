---
import WebsiteLayout from "@/layouts/WebsiteLayout.astro";
import ComingSoonLanding from "@/features/pages/ComingSoonLanding.astro";

const features = [
  {
    title: "Estudio Flexible",
    description: "Accede a tus clases, materiales y videos las 24 horas del día, los 7 días de la semana, a tu propio ritmo.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`
  },
  {
    title: "Seguimiento de Progreso",
    description: "Monitorea tu avance, descarga material complementario y realiza evaluaciones interactivas en tu panel.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z" />
    </svg>`
  },
  {
    title: "Soporte de Tutores",
    description: "Resuelve tus dudas directamente con los ponentes y consultores a través de foros y chats de consulta.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>`
  }
];
---

<WebsiteLayout 
  title="Aula Virtual | MAIA Consultores" 
  description="Plataforma de capacitación en línea para profesionales de calidad, inocuidad alimentaria y saneamiento."
>
  <ComingSoonLanding
    badge="Plataforma de Aprendizaje"
    title="Aula Virtual MAIA"
    subtitle="Estudia a tu propio ritmo desde cualquier lugar"
    description="Accede a nuestro espacio virtual de aprendizaje interactivo, diseñado especialmente para capacitar de forma flexible e integral a tus colaboradores."
    features={features}
    projectId="aula-virtual"
  />
</WebsiteLayout>
