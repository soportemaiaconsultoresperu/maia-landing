---
import WebsiteLayout from "@/layouts/WebsiteLayout.astro";
import ComingSoonLanding from "@/features/pages/ComingSoonLanding.astro";

const features = [
  {
    title: "Fomento de I+D+i",
    description: "Accede a recursos no reembolsables para investigación, desarrollo tecnológico y validación de productos.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
    </svg>`
  },
  {
    title: "Formulación Técnica",
    description: "Diseño metodológico, estructuración técnica y financiera para asegurar la viabilidad de la postulación.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>`
  },
  {
    title: "Gestión & Cierre",
    description: "Acompañamiento integral en la ejecución del proyecto, rendición de cuentas e informes de hitos.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>`
  }
];
---

<WebsiteLayout 
  title="Proyecto Innóvate | MAIA Consultores" 
  description="Consultoría para la postulación y gestión de fondos concursables de Innóvate Perú. Potencia la innovación en tu empresa."
>
  <ComingSoonLanding
    badge="Fondos Concursables"
    title="Proyecto Innóvate"
    subtitle="Cofinancia la innovación de tu empresa"
    description="Te acompañamos de inicio a fin en la postulación, estructuración y ejecución de proyectos de desarrollo tecnológico y modernización digital para acceder a fondos no reembolsables de ProInnóvate."
    features={features}
    projectId="proyectos-innovate"
  />
</WebsiteLayout>
