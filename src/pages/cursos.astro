---
import WebsiteLayout from "@/layouts/WebsiteLayout.astro";
import ComingSoonLanding from "@/features/pages/ComingSoonLanding.astro";

const features = [
  {
    title: "Certificación Valida",
    description: "Obtén certificados respaldados que acreditan el cumplimiento de normativas de higiene y calidad.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
    </svg>`
  },
  {
    title: "Docentes Consultores",
    description: "Clases y mentorías guiadas por auditores sanitarios y profesionales activos del sector.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>`
  },
  {
    title: "Metodología Práctica",
    description: "Casos prácticos, talleres en vivo y recursos descargables listos para aplicar en tu empresa.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 9.172V5L8 4z" />
    </svg>`
  }
];
---

<WebsiteLayout 
  title="Cursos de Capacitación | MAIA Consultores" 
  description="Programas de capacitación y cursos especializados en inocuidad alimentaria, sanidad ambiental y control de plagas."
>
  <ComingSoonLanding
    badge="Formación y Capacitación"
    title="Cursos de Formación"
    subtitle="Especialízate con los mejores profesionales"
    description="Descubre nuestro catálogo de cursos especializados diseñados para fortalecer las competencias técnicas de tu organización en calidad, inocuidad alimentaria, y sanidad ambiental."
    features={features}
    projectId="cursos"
  />
</WebsiteLayout>
