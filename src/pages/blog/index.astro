---
import WebsiteLayout from "@/layouts/WebsiteLayout.astro";
import ComingSoonLanding from "@/features/pages/ComingSoonLanding.astro";

const features = [
  {
    title: "Artículos Técnicos",
    description: "Análisis profundos redactados por consultores expertos en inocuidad, sanidad y gestión ambiental.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
    </svg>`
  },
  {
    title: "Actualidad Regulatoria",
    description: "Información actualizada de decretos, resoluciones y normativas de DIGESA, SENASA y entes reguladores.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
    </svg>`
  },
  {
    title: "Guías & Casos Prácticos",
    description: "Recursos paso a paso para la optimización de procesos operativos e higiénicos en tu empresa.",
    iconSvg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
    </svg>`
  }
];
---

<WebsiteLayout 
  title="Blog Técnico y Novedades | MAIA Consultores" 
  description="Artículos sobre inocuidad alimentaria, saneamiento ambiental, plagas y gestión empresarial. Mantente al día."
>
  <ComingSoonLanding
    badge="Artículos y Guías"
    title="Blog de MAIA"
    subtitle="Conocimiento técnico y actualidad"
    description="Muy pronto compartiremos contigo guías prácticas, análisis de legislación sanitaria y las mejores recomendaciones de nuestros expertos para potenciar la inocuidad y saneamiento en tu industria."
    features={features}
    projectId="blog"
  />
</WebsiteLayout>
