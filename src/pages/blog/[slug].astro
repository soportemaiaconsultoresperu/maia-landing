---
import type { Post } from "@/types/content";
import WebsiteLayout from "@/layouts/WebsiteLayout.astro";
import BlogArticle from "@/features/blog/BlogArticle.astro";
import { loadPosts } from "@/lib/wordpress/posts";

export async function getStaticPaths() {
  const { posts } = await loadPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props { post: Post }
const { post } = Astro.props;
---
<WebsiteLayout title={post.title} description={post.excerpt} seo={{ ...post.seo, type: "article", publishedTime: post.publishedAt, modifiedTime: post.updatedAt, image: post.seo?.image ?? post.cover?.url }}>
  <BlogArticle post={post} />
</WebsiteLayout>
