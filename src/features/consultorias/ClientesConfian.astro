---
import { Image } from "astro:assets";

import universal from "@/assets/images/logos/universal_logo.png";
import dolce from "@/assets/images/logos/dolce_logo.png";
import cooper from "@/assets/images/logos/cooper_logo.png";
import cosechas from "@/assets/images/logos/cosechas_logo.png";

// Additional relevant logos if needed to fill space/loop, or we can just loop these 4
const logos = [
  { src: universal, alt: "Universal" },
  { src: dolce, alt: "Dolce Delizia" },
  { src: cooper, alt: "Cooper Bros" },
  { src: cosechas, alt: "Cosechas Peruanas" },
];

// Duplicate list for infinite/smooth looping if needed
const duplicatedLogos = [...logos, ...logos, ...logos, ...logos];
---

<section class="py-16 bg-white overflow-hidden">
  <div class="container mx-auto px-4 max-w-6xl">
    <h2
      class="text-2xl md:text-2xl font-black text-[#153f70] text-center mb-10 md:mb-12 tracking-wider uppercase"
    >
      Empresas que confían en nosotros
    </h2>

    <div class="relative w-full flex items-center">
      <!-- Prev Button -->
      <button
        id="prevBtn"
        class="absolute -left-2 md:-left-12 z-20 w-10 h-10 bg-[#888888] rounded-full flex items-center justify-center text-white hover:bg-gray-700 transition-all duration-300 shadow-md focus:outline-none"
        aria-label="Anterior"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>

      <!-- Carousel Container -->
      <div
        id="logoCarousel"
        class="flex gap-4 md:gap-6 overflow-x-hidden no-scrollbar w-full px-2 py-4 cursor-grab active:cursor-grabbing"
      >
        {
          duplicatedLogos.map((logo, index) => (
            <div
              class="logo-card shrink-0 bg-white rounded-2xl border border-gray-200 shadow-sm p-6 flex items-center justify-center h-28 md:h-36 transition-all duration-300 hover:shadow-md hover:border-gray-300"
              data-index={index}
            >
              <div class="w-full h-full flex items-center justify-center p-1">
                <Image
                  src={logo.src}
                  alt={logo.alt}
                  class="max-h-full max-w-full w-auto h-auto object-contain transition-transform duration-300 hover:scale-105"
                />
              </div>
            </div>
          ))
        }
      </div>

      <!-- Next Button -->
      <button
        id="nextBtn"
        class="absolute -right-2 md:-right-12 z-20 w-10 h-10 bg-[#888888] rounded-full flex items-center justify-center text-white hover:bg-gray-700 transition-all duration-300 shadow-md focus:outline-none"
        aria-label="Siguiente"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .logo-card {
    width: calc(100vw - 3rem); /* Mobile: almost full width */
  }

  @media (min-width: 640px) {
    .logo-card {
      width: calc((100% - 1.5rem) / 2); /* 2 columns */
    }
  }

  @media (min-width: 768px) {
    .logo-card {
      width: calc((100% - 3rem) / 3); /* 3 columns */
    }
  }

  @media (min-width: 1024px) {
    .logo-card {
      width: calc((100% - 4.5rem) / 4); /* 4 columns */
    }
  }
</style>

<script>
  const carousel = document.getElementById("logoCarousel");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");

  if (carousel && prevBtn && nextBtn) {
    let isPaused = false;
    let scrollSpeed = 1; // pixels per frame
    let resumeTimeout: number;

    const cardWidth = () => {
      const card = carousel.querySelector(".logo-card") as HTMLElement;
      if (!card) return 250;
      const style = window.getComputedStyle(carousel);
      const gap = parseInt(style.columnGap || style.gap || "0");
      return card.offsetWidth + gap;
    };

    // Set initial scroll to the middle group for seamless looping
    const totalContentWidth = carousel.scrollWidth / 4;
    carousel.scrollLeft = totalContentWidth;

    const step = () => {
      if (!isPaused) {
        carousel.scrollLeft += scrollSpeed;

        // Loop boundaries
        if (carousel.scrollLeft >= totalContentWidth * 3) {
          carousel.scrollLeft -= totalContentWidth;
        } else if (carousel.scrollLeft <= totalContentWidth) {
          carousel.scrollLeft += totalContentWidth;
        }
      }
      requestAnimationFrame(step);
    };

    requestAnimationFrame(step);

    const pauseAutoScroll = (duration = 5000) => {
      isPaused = true;
      clearTimeout(resumeTimeout);
      resumeTimeout = window.setTimeout(() => {
        isPaused = false;
      }, duration);
    };

    // Pause auto scroll on interaction
    carousel.addEventListener("mouseenter", () => {
      isPaused = true;
      clearTimeout(resumeTimeout);
    });

    carousel.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    carousel.addEventListener(
      "touchstart",
      () => {
        isPaused = true;
        clearTimeout(resumeTimeout);
      },
      { passive: true },
    );

    // Buttons
    nextBtn.addEventListener("click", () => {
      pauseAutoScroll();
      carousel.scrollTo({
        left: carousel.scrollLeft + cardWidth(),
        behavior: "smooth",
      });
    });

    prevBtn.addEventListener("click", () => {
      pauseAutoScroll();
      carousel.scrollTo({
        left: carousel.scrollLeft - cardWidth(),
        behavior: "smooth",
      });
    });
  }
</script>
