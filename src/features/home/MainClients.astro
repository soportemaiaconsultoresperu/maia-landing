---
import { Image } from "astro:assets";

import ambipar from "@/assets/images/logos/ambipar_logo.png";
import c_logo from "@/assets/images/logos/c_logo.png";
import convida from "@/assets/images/logos/convida_logo.png";
import cooper from "@/assets/images/logos/cooper_logo.png";
import cosechas from "@/assets/images/logos/cosechas_logo.png";
import cynara from "@/assets/images/logos/cynara_logo.png";
import danhia from "@/assets/images/logos/danhia_logo.png";
import dolce from "@/assets/images/logos/dolce_logo.png";
import ecoandino from "@/assets/images/logos/ecoandino_logo.png";
import ecotec from "@/assets/images/logos/ecotec_logo.png";
import elan from "@/assets/images/logos/elan_logo.png";
import icsanam from "@/assets/images/logos/icsanam_logo.png";
import lopez from "@/assets/images/logos/lopez_logo.png";
import nutraestevia from "@/assets/images/logos/nutraestevia_logo.png";
import passion from "@/assets/images/logos/passion_logo.png";
import pikeos from "@/assets/images/logos/pikeos_logo.png";
import ryc from "@/assets/images/logos/ryc_logo.png";
import tama from "@/assets/images/logos/tama_logo.png";
import universal from "@/assets/images/logos/universal_logo.png";
import valles from "@/assets/images/logos/valles_logo.png";
import vitallanos from "@/assets/images/logos/vitallanos_logo.png";
import yafaesca from "@/assets/images/logos/yafaesca_logo.png";

const logos = [
  universal,
  cooper,
  ecoandino,
  c_logo,
  lopez,
  tama,
  ecotec,
  passion,
  ambipar,
  convida,
  cosechas,
  cynara,
  danhia,
  dolce,
  elan,
  icsanam,
  nutraestevia,
  pikeos,
  ryc,
  valles,
  vitallanos,
  yafaesca,
];

// Group logos into columns of 2
const columns = [];
for (let i = 0; i < logos.length; i += 2) {
  columns.push([logos[i], logos[i + 1]].filter(Boolean));
}

// Triplicate the columns to ensure enough content for seamless looping and manual scrolling
const tripleColumns = [...columns, ...columns, ...columns];
---

<section class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="container mx-auto px-4">
    <h2
      class="text-2xl md:text-3xl font-bold text-black text-center mb-10 md:mb-16 tracking-tight uppercase"
    >
      Empresas que confían en Maia Consultores
    </h2>

    <div class="relative w-full group max-w-6xl mx-auto">
      <!-- Gradient Overlays - Hidden on mobile to save space/performance -->
      <div
        class="hidden md:block absolute left-0 top-0 bottom-0 w-24 md:w-32 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"
      >
      </div>
      <div
        class="hidden md:block absolute right-0 top-0 bottom-0 w-24 md:w-32 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"
      >
      </div>

      <!-- Navigation Buttons - Smaller on mobile -->
      <button
        id="clientPrevBtn"
        class="absolute -left-2 md:-left-12 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 bg-[#5c5c5c] rounded-full flex items-center justify-center text-white hover:bg-gray-800 transition-all duration-300 shadow-md"
        aria-label="Previous"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 md:w-6 md:h-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
      </button>

      <button
        id="clientNextBtn"
        class="absolute -right-2 md:-right-12 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 bg-[#5c5c5c] rounded-full flex items-center justify-center text-white hover:bg-gray-800 transition-all duration-300 shadow-md"
        aria-label="Next"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 md:w-6 md:h-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
        >
      </button>

      <!-- Carousel Container -->
      <div
        id="clientCarousel"
        class="flex gap-4 md:gap-6 overflow-x-hidden no-scrollbar cursor-grab active:cursor-grabbing px-4 md:px-0"
      >
        {
          tripleColumns.map((col, index) => (
            <div
              class="flex flex-col gap-4 md:gap-6 client-column shrink-0"
              data-index={index % columns.length}
            >
              {col.map((logo) => (
                <div class="bg-white rounded-xl p-4 h-32 md:h-48 flex items-center justify-center border border-gray-200 group/card overflow-hidden w-full transition-shadow hover:shadow-md">
                  <div class="w-full h-full flex items-center justify-center p-2 md:p-4">
                    <Image
                      src={logo}
                      alt="Cliente"
                      class="max-h-full max-w-full w-auto h-auto object-contain transition-transform duration-500 group-hover/card:scale-110"
                    />
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .client-column {
    width: calc(100vw - 2rem); /* Mobile: Full width minus padding */
  }

  @media (min-width: 640px) {
    .client-column {
      width: calc(
        (100% - 1.5rem) / 2
      ); /* Tablet: 2 columns, 1 gap of 1.5rem (gap-6) */
    }
  }

  @media (min-width: 1024px) {
    .client-column {
      width: calc(
        (100% - 4.5rem) / 4
      ); /* Desktop: 4 columns, 3 gaps of 1.5rem (gap-6) */
    }
  }
</style>

<script>
  const carousel = document.getElementById("clientCarousel");
  const prevBtn = document.getElementById("clientPrevBtn");
  const nextBtn = document.getElementById("clientNextBtn");

  if (carousel && prevBtn && nextBtn) {
    let isPaused = false;
    let scrollSpeed = 1; // pixels per frame
    let resumeTimeout: number;

    const columnWidth = () => {
      const firstCol = carousel.querySelector(".client-column") as HTMLElement;
      if (!firstCol) return 300;
      const style = window.getComputedStyle(carousel);
      const gap = parseInt(style.columnGap || style.gap || "0");
      return firstCol.offsetWidth + gap;
    };

    // Initialize position to the middle set of clones for seamless initial scroll
    const totalContentWidth = carousel.scrollWidth / 3;
    carousel.scrollLeft = totalContentWidth;

    const step = () => {
      if (!isPaused) {
        carousel.scrollLeft += scrollSpeed;

        // Reset to middle if it goes too far
        if (carousel.scrollLeft >= totalContentWidth * 2) {
          carousel.scrollLeft -= totalContentWidth;
        } else if (carousel.scrollLeft <= totalContentWidth - 10) {
          carousel.scrollLeft += totalContentWidth;
        }
      }
      requestAnimationFrame(step);
    };

    requestAnimationFrame(step);

    const pauseAutoScroll = (duration = 5000) => {
      isPaused = true;
      clearTimeout(resumeTimeout);
      resumeTimeout = window.setTimeout(() => {
        isPaused = false;
      }, duration);
    };

    // Pause on hover
    carousel.addEventListener("mouseenter", () => {
      isPaused = true;
      clearTimeout(resumeTimeout);
    });
    carousel.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    // Manual Controls
    nextBtn.addEventListener("click", () => {
      pauseAutoScroll();
      carousel.scrollTo({
        left: carousel.scrollLeft + columnWidth(),
        behavior: "smooth",
      });
    });

    prevBtn.addEventListener("click", () => {
      pauseAutoScroll();
      carousel.scrollTo({
        left: carousel.scrollLeft - columnWidth(),
        behavior: "smooth",
      });
    });

    // Handle smooth scrolling "jump" with a small timeout or scroll event
    // To keep it simple, we just rely on the next animation frame to detect position
  }
</script>
