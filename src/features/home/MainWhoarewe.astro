---
import { Image } from "astro:assets";
import collage from "@/assets/images/collage.png";
import backgroundCollage from "@/assets/images/background_collage.png";
---

<section
  id="quienes-somos"
  class="relative bg-[#ecf0fe] py-48 px-6 lg:px-12 overflow-hidden"
  style="min-height: 100vh;"
>
  <!-- Section Background -->
  <Image
    src={backgroundCollage}
    alt="Fondo Decorativo"
    class="absolute top-0 left-0 w-full h-full object-cover -z-0 opacity-80"
  />

  <div class="container mx-auto max-w-[1600px] relative z-10">
    <div
      class="flex flex-col lg:flex-row items-center lg:items-start gap-12 lg:gap-32 animate-on-scroll"
    >
      <!-- Left (Top on Mobile): Text Content -->
      <div class="w-full lg:w-[40%] order-1 lg:order-1">
        <div class="max-w-xl mx-auto lg:mx-0">
          <!-- Title Box -->
          <div
            class="bg-[#204691] inline-block px-12 lg:px-24 xl:px-40 py-5 rounded-[16px] mb-12 shadow-xl border-b-4 border-black/10 text-center w-full md:w-auto"
          >
            <h2
              class="text-white text-3xl md:text-4xl font-bold tracking-tight whitespace-nowrap"
            >
              ¿QUIÉNES SOMOS?
            </h2>
          </div>

          <div class="space-y-8 text-2xl text-[#000] leading-relaxed">
            <p>
              <strong class="text-[#204691] font-extrabold"
                >Maia Consultores</strong
              > nace al identificar que muchas empresas buscan expandirse en el mercado
              y, para lograrlo, necesitan certificarse y cumplir con la normativa
              vigente.
            </p>

            <p>
              En ese contexto, formamos un equipo de profesionales
              especializados en gestión de calidad, inocuidad y saneamiento
              ambiental, que brinda un acompañamiento personalizado, ágil y
              oportuno para ayudar a las empresas a alcanzar sus objetivos.
            </p>

            <p>
              Con el tiempo, ampliamos nuestros servicios e incursionamos en el
              desarrollo de software especializado para los sectores de
              saneamiento ambiental, industria alimentaria y gestión de residuos
              sólidos.
            </p>
          </div>
        </div>
      </div>

      <!-- Right (Bottom on Mobile): Collage of Images -->
      <div
        class="w-full lg:w-[60%] relative flex justify-center items-center order-2 lg:order-2 mt-10 lg:mt-0"
      >
        <div
          class="relative w-full max-w-[950px] lg:scale-110 lg:translate-x-4"
        >
          <!-- Main Collage -->
          <Image
            src={collage}
            alt="Equipo Maia Consultores"
            class="relative w-full h-auto z-10 drop-shadow-2xl"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom shapes matching the design */
  #quienes-somos {
    position: relative;
  }

  /* Smooth animations */
  p {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s ease-out forwards;
  }

  p:nth-child(1) {
    animation-delay: 0.2s;
  }
  p:nth-child(2) {
    animation-delay: 0.4s;
  }
  p:nth-child(3) {
    animation-delay: 0.6s;
  }

  .animate-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .animate-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
      }
    });
  }, observerOptions);

  document.querySelectorAll(".animate-on-scroll").forEach((el) => {
    observer.observe(el);
  });
</script>
