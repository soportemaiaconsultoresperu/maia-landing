---
import { Image } from "astro:assets";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";

import imagen12 from "@/assets/images/maia_plagas_license/IMAGENES/IMAGEN 10.png";
---

<section
  id="prueba-gratis"
  class="relative py-16 sm:py-20 overflow-hidden bg-white"
>
  <!-- Split background -->
  <div class="absolute inset-0 z-0 flex flex-col pointer-events-none">
    <div class="h-[60%] bg-white"></div>
    <div class="h-[40%] bg-[#311A6B]"></div>
  </div>

  <div class="container mx-auto max-w-[1200px] px-5 sm:px-10 relative z-10">
    <div
      class="bg-[#F2F2F2] rounded-[32px] sm:rounded-[48px] p-6 sm:p-10 lg:p-12 flex flex-col md:flex-row items-center justify-between gap-8 sm:gap-10 shadow-xl"
    >
      <!-- LEFT: Text + Badges + Button -->
      <div
        class="w-full md:w-[48%] flex flex-col items-center md:items-start text-center md:text-left"
      >
        <h2
          class="text-[28px] sm:text-[34px] lg:text-[40px] font-bold text-[#311A6B] leading-[1.15] mb-6 text-center"
          style="font-family: Poppins, sans-serif;"
        >
          Prueba Maia Plagas Licencia<br />
          <span class="relative inline-block text-[#0066FF] mt-1">
            GRATIS
            <svg
              class="absolute left-0 -bottom-3.5 w-full h-3.5 text-[#0066FF]"
              viewBox="0 0 100 12"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="none"
            >
              <path
                d="M3 2C30 9 70 9 97 2"
                stroke="currentColor"
                stroke-width="5"
                stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="text-[#311A6B]"> por 15 días</span>
        </h2>

        <!-- White Badge -->
        <div
          class="bg-white rounded-[16px] py-4 px-6 mb-8 w-full shadow-sm text-center"
        >
          <p
            class="text-black text-sm sm:text-base md:text-2xl font-semibold leading-snug"
            style="font-family: Poppins, sans-serif;"
          >
            ¡Agenda una demo y descubre<br />cómo ahorrar horas de trabajo!
          </p>
        </div>

        <!-- CTA Button -->
        <div class="w-full">
          <a
            href="#contacto"
            class="block w-full text-center py-4 px-8 rounded-[12px] font-black text-[#311A6B] text-[16px] sm:text-[18px] uppercase tracking-wider transition-all duration-250 hover:scale-[1.02] hover:brightness-105 active:scale-95 shadow-md hover:shadow-lg"
            style="background-color: #4DE5BC; font-family: Poppins, sans-serif;"
          >
            AGENDAR DEMO
          </a>
        </div>
      </div>

      <!-- RIGHT: Photo -->
      <div class="w-full md:w-[48%] flex-shrink-0">
        <div class="rounded-[24px] overflow-hidden shadow-md">
          <Image
            src={imagen12}
            alt="Reunión de negocio mostrando Maia Plagas en laptop"
            class="w-full h-auto object-cover max-h-[380px] sm:max-h-[440px]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
