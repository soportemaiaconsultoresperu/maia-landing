---
import { Image } from "astro:assets";
import formularioImg from "@/assets/images/FORMULARIO.png";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
---

<section id="contacto" class="py-20 bg-slate-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <div
      class="flex flex-col lg:flex-row bg-[#eef2f9] rounded-3xl overflow-hidden shadow-lg border border-slate-100"
    >
      <!-- Image Section -->
      <div
        class="w-full lg:w-1/2 relative h-64 lg:h-auto min-h-[320px] lg:min-h-full"
      >
        <Image
          src={formularioImg}
          alt="Equipo en reunión"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-emerald-950/20 mix-blend-multiply">
        </div>
      </div>

      <!-- Form Section -->
      <div class="w-full lg:w-1/2 p-8 md:p-12">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-[#00c0a9]/20 px-4 py-1.5 text-xs font-semibold text-[#151249] mb-4 border border-[#00c0a9]/30"
        >
          Prueba de 15 Días Gratis
        </span>
        <h2 class="text-3xl font-extrabold text-slate-800 mb-2">
          Empieza a optimizar tu negocio hoy
        </h2>
        <p class="text-slate-800 text-base md:text-2xl leading-relaxed mb-8">
          Completa el formulario para agendar una demostración en vivo
          personalizada con uno de nuestros consultores de software y solicita
          tu prueba gratuita de 15 días de Maia Business.
        </p>

        <form id="businessDemoForm" class="space-y-4">
          <div>
            <input
              type="text"
              id="name"
              placeholder="Nombre Completo"
              required
              class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white text-gray-800 placeholder-gray-400 focus:outline-none transition-all"
            />
          </div>

          <div class="flex flex-col md:flex-row gap-4">
            <div class="w-full md:w-1/2">
              <input
                type="email"
                id="email"
                placeholder="Correo Corporativo"
                required
                class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white text-gray-800 placeholder-gray-400 focus:outline-none transition-all"
              />
            </div>
            <div class="w-full md:w-1/2">
              <input
                type="text"
                id="company"
                placeholder="Nombre de la Empresa"
                required
                class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white text-gray-800 placeholder-gray-400 focus:outline-none transition-all"
              />
            </div>
          </div>

          <div>
            <select
              id="technicians"
              required
              class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white text-gray-800 placeholder-gray-400 focus:outline-none transition-all cursor-pointer"
            >
              <option value="" disabled selected>Número de Colaboradores</option
              >
              <option value="1-5">1 - 5 personas</option>
              <option value="6-15">6 - 15 personas</option>
              <option value="16-50">16 - 50 personas</option>
              <option value="50+">Más de 50 personas</option>
            </select>
          </div>

          <div>
            <textarea
              id="message"
              placeholder="Cuéntanos un poco sobre las necesidades operativas de tu empresa..."
              rows="4"
              class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white text-gray-800 placeholder-gray-400 focus:outline-none transition-all resize-none"
            ></textarea>
          </div>

          <div class="flex justify-end w-full pt-2">
            <button
              type="submit"
              class="w-full bg-[#00af9b] hover:bg-[#009685] text-white font-bold py-3.5 px-10 rounded-full transition-colors duration-300 shadow-md hover:shadow-emerald-500/10"
            >
              ENVIAR SOLICITUD DE DEMO
            </button>
          </div>
        </form>

        <!-- Success message -->
        <div id="formSuccess" class="hidden text-center py-8 space-y-4">
          <div
            class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-10 w-10"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
          </div>
          <h3 class="text-2xl font-bold text-slate-800">¡Solicitud Enviada!</h3>
          <p class="text-slate-700 max-w-sm mx-auto">
            Hemos recibido tu información. Uno de nuestros consultores de
            software se pondrá en contacto contigo en las próximas 24 horas
            hábiles.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupDemoForm } from "../../../utils/demoFormSubmit";
  setupDemoForm("businessDemoForm", "Maia Business");
</script>
