---
import { Image } from "astro:assets";
import imgDemo from "@/assets/images/maia_business/AGENDAR DEMO.png";
---

<section id="cta" class="relative bg-white mt-20">
  <!-- Split background: top half matches the page bg (slate-100), bottom half matches the dark section/footer style -->
  <div class="absolute inset-0 flex flex-col pointer-events-none z-0">
    <div class="h-[60%] bg-white"></div>
    <div class="h-[40%] bg-[#151249]"></div>
  </div>

  <div
    class="container mx-auto max-w-[1344px] px-[20px] sm:px-[45px] relative z-10 pb-16 lg:pb-24"
  >
    <!-- Main Card Container -->
    <div
      class="bg-[#f3f4f6] rounded-[40px] overflow-hidden shadow-xl border border-white/50 flex flex-col lg:flex-row items-stretch"
    >
      <!-- Left Content Column -->
      <div
        class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left p-8 md:p-12 lg:p-16 lg:pr-8 justify-center space-y-8"
      >
        <!-- Main Heading -->
        <h2
          class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-[#151249] leading-tight text-center"
          style="font-family: 'Poppins', sans-serif;"
        >
          Prueba Maia Business
          <span class="relative inline-block mx-1">
            <span class="text-[#00c0a9]">GRATIS</span>
            <!-- Smile Arc SVG below GRATIS -->
            <svg
              class="absolute left-1/2 -translate-x-1/2 -bottom-3.5 w-[110%] h-4"
              viewBox="0 0 100 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M5 5C30 18 70 18 95 5"
                stroke="#00c0a9"
                stroke-width="5"
                stroke-linecap="round"></path>
            </svg>
          </span>
          por 15 días
        </h2>

        <!-- Subheading Callout -->
        <div
          class="bg-white rounded-2xl py-4 px-6 md:px-8 shadow-sm border border-slate-100 w-full max-w-[460px]"
        >
          <p
            class="text-[#153f70] font-semibold text-sm sm:text-base md:text-2xl leading-relaxed text-center"
            style="font-family: 'Poppins', sans-serif;"
          >
            ¡Agenda una demo y descubre cómo tener un software propio!
          </p>
        </div>

        <!-- CTA Button -->
        <div class="w-full max-w-[460px]">
          <a
            href="#contacto"
            class="inline-flex w-full items-center justify-center bg-[#00c0a9] text-white font-extrabold text-base sm:text-lg px-10 py-4 rounded-[14px] hover:bg-[#00a894] transition-all duration-300 uppercase tracking-wider hover:scale-[1.02] active:scale-95 shadow-lg shadow-[#00c0a9]/20 text-center"
            style="font-family: 'Poppins', sans-serif;"
          >
            Agendar Demo
          </a>
        </div>
      </div>

      <!-- Right Image Column -->
      <div
        class="w-full lg:w-[50%] shrink-0 relative min-h-[320px] lg:min-h-full"
      >
        <Image
          src={imgDemo}
          alt="Prueba Maia Business gratis"
          class="absolute inset-0 w-full h-full object-cover"
          quality="max"
        />
      </div>
    </div>
  </div>
</section>
