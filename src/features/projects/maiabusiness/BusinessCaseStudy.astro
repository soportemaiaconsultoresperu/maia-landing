---
import { Image } from "astro:assets";

// Background and feature images
import bgCaseStudy from "@/assets/images/maia_business/FONDO DE CASO DE EXITO.png";
import imgProgramacion from "@/assets/images/maia_business/PROGRAMACION DE SERVICIOS.png";
import imgDocumentacion from "@/assets/images/maia_business/GESTION DE DOCUMENTACION.png";
import imgCapacitacion from "@/assets/images/maia_business/GESTION DE CAPACITACION.png";

// Benefit icons
import iconProcesos from "@/assets/images/maia_business/ICONOS/PROCESOS + RAPIDOS.png";
import iconProductividad from "@/assets/images/maia_business/ICONOS/MAYOR PRODUCTIVIDAD.png";
import iconErrores from "@/assets/images/maia_business/ICONOS/MENOS ERRORES.png";
import iconCrecimiento from "@/assets/images/maia_business/ICONOS/CRECIMIENTO.png";

const benefits = [
  { icon: iconProcesos, label: "Procesos más rápidos" },
  { icon: iconProductividad, label: "Mayor productividad" },
  { icon: iconErrores, label: "Menos errores operativos" },
  { icon: iconCrecimiento, label: "Escalabilidad para el crecimiento del negocio" },
];

const features = [
  {
    title: "Programación de Servicios",
    description: "Define la fecha, hora y proveedor de cada servicio de control de plagas.",
    image: imgProgramacion,
    gradient: "linear-gradient(135deg, #2563eb 0%, #10b981 100%)",
  },
  {
    title: "Gestión de documentación",
    description: "Organiza y almacena toda la documentación de control de plagas.",
    image: imgDocumentacion,
    gradient: "linear-gradient(135deg, #1d4ed8 0%, #10b981 50%, #84cc16 100%)",
  },
  {
    title: "Gestión de capacitaciones",
    description: "Almacena y gestiona las capacitaciones y certificaciones de tu personal.",
    image: imgCapacitacion,
    gradient: "linear-gradient(135deg, #1d4ed8 0%, #f97316 60%, #eab308 100%)",
  },
];
---

<section id="caso-de-exito" class="caso-exito-section relative overflow-hidden">
  <div class="caso-exito-grid">

    <!-- ════════════════════ LEFT PANEL ════════════════════ -->
    <div class="left-panel">
      <!-- BG image overlay -->
      <div class="left-bg-image" aria-hidden="true">
        <Image
          src={bgCaseStudy}
          alt=""
          class="w-full h-full object-cover object-center"
          quality="mid"
        />
      </div>
      <!-- Dark gradient overlay -->
      <div class="left-overlay" aria-hidden="true"></div>

      <!-- Content -->
      <div class="left-content">
        <!-- Badge -->
        <div class="badge-wrapper">
          <span class="caso-badge">CASO DE ÉXITO</span>
        </div>

        <!-- Title -->
        <h2 class="left-title">
          <span class="title-highlight">Sistema de Gestión<br />Documentaria</span>{" "}
          <span class="title-white">para<br />Empresa de Alimentos</span>
        </h2>

        <!-- Benefits grid -->
        <div class="benefits-grid">
          {benefits.map((b) => (
            <div class="benefit-item">
              <div class="benefit-icon-wrap">
                <Image
                  src={b.icon}
                  alt={b.label}
                  class="benefit-icon"
                  quality="mid"
                />
              </div>
              <p class="benefit-label">{b.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ════════════════════ RIGHT PANEL ════════════════════ -->
    <div class="right-panel">
      <div class="features-list">
        {features.map((feat, index) => (
          <div class="feature-row">
            <!-- Blob with screenshot -->
            <div class="feature-blob-wrapper">
              <div class="blob-circle" style={`background: ${feat.gradient};`}></div>
              <div class="mockup-container">
                <Image
                  src={feat.image}
                  alt={feat.title}
                  class="mockup-image"
                  quality="high"
                />
              </div>
            </div>

            <!-- Feature text -->
            <div class="feature-text">
              <h3 class="feature-title text-sm sm:text-base md:text-2xl">{feat.title}</h3>
              <p class="feature-desc text-sm sm:text-base md:text-2xl">{feat.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* ─── Section wrapper ─── */
  .caso-exito-section {
    font-family: 'Poppins', sans-serif;
    background: #f7f9fc;
  }

  /* ─── Two-column grid ─── */
  .caso-exito-grid {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 680px;
  }

  @media (min-width: 1024px) {
    .caso-exito-grid {
      grid-template-columns: 34% 66%;
      min-height: 850px;
    }
  }

  @media (min-width: 1400px) {
    .caso-exito-grid {
      grid-template-columns: 30% 70%;
    }
  }

  /* ════════════ LEFT PANEL ════════════ */
  .left-panel {
    position: relative;
    background: #0f1640;
    padding: 80px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .left-bg-image {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    mix-blend-mode: luminosity;
  }

  .left-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      #0b1033 0%,
      #151249 50%,
      #0b0e30 100%
    );
    opacity: 0.93;
  }

  .left-content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Badge */
  .badge-wrapper {
    margin-bottom: 28px;
  }

  .caso-badge {
    display: inline-block;
    border: 2px solid #ffffff;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 8px 24px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  /* Title */
  .left-title {
    font-size: clamp(1.8rem, 3.5vw, 2.3rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 48px;
    color: #fff;
    text-align: center;
  }

  .title-highlight {
    color: #3de0b8; /* Mint/green color matching the screenshot */
  }

  .title-white {
    color: #ffffff;
  }

  /* Benefits Grid (2x2 crossed dashed border style) */
  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  .benefit-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 36px 20px;
    gap: 16px;
    position: relative;
    transition: background 0.25s ease;
  }

  .benefit-item:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  /* Crossed lines dividers */
  .benefit-item:nth-child(1) {
    border-right: 1px dashed rgba(255, 255, 255, 0.35);
    border-bottom: 1px dashed rgba(255, 255, 255, 0.35);
  }

  .benefit-item:nth-child(2) {
    border-bottom: 1px dashed rgba(255, 255, 255, 0.35);
  }

  .benefit-item:nth-child(3) {
    border-right: 1px dashed rgba(255, 255, 255, 0.35);
  }

  .benefit-icon-wrap {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .benefit-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .benefit-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.35;
    margin: 0;
    max-width: 160px;
  }

  /* ════════════ RIGHT PANEL ════════════ */
  .right-panel {
    background: #f7f9fc;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 48px;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 72px;
    width: 100%;
    max-width: 1050px;
  }

  /* Feature row */
  .feature-row {
    display: flex;
    align-items: center;
    gap: 60px;
    opacity: 0;
    transform: translateX(24px);
    animation: slideInRight 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .feature-row:nth-child(1) { animation-delay: 0.1s; }
  .feature-row:nth-child(2) { animation-delay: 0.28s; }
  .feature-row:nth-child(3) { animation-delay: 0.46s; }

  /* Blob with overlapping rectangular mockup */
  .feature-blob-wrapper {
    flex-shrink: 0;
    position: relative;
    width: 580px;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blob-circle {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    z-index: 1;
    left: 40px;
    opacity: 0.85;
  }

  .mockup-container {
    position: relative;
    z-index: 2;
    width: 500px; /* 500px wide image mockup */
    transform: translate(35px, 10px);
    transition: transform 0.3s ease;
  }

  .mockup-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.16));
  }

  .feature-row:hover .mockup-container {
    transform: translate(25px, 0px) scale(1.03);
  }

  /* Feature text */
  .feature-text {
    flex: 1;
  }

  .feature-title {
    /* font-size: 1.55rem; */
    font-weight: 700;
    color: #0f1640;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .feature-desc {
    /* font-size: 1.05rem; */
    color: #2d3748; /* Darker grey for high readability */
    line-height: 1.65;
    margin: 0;
    max-width: 440px;
  }

  /* ─── Animations ─── */
  @keyframes slideInRight {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* ─── Responsive adjustments ─── */
  @media (max-width: 1280px) {
    .feature-blob-wrapper {
      width: 460px;
      height: 320px;
    }

    .blob-circle {
      width: 260px;
      height: 260px;
      left: 30px;
    }

    .mockup-container {
      width: 400px;
      transform: translate(25px, 5px);
    }
  }

  @media (max-width: 1023px) {
    .left-panel {
      padding: 60px 24px;
    }

    .right-panel {
      padding: 60px 24px;
    }

    .feature-row {
      flex-direction: column;
      text-align: center;
      gap: 28px;
    }

    .feature-blob-wrapper {
      width: 100%;
      max-width: 500px;
      height: 360px;
      margin: 0 auto;
    }

    .blob-circle {
      left: 10%;
      width: 280px;
      height: 280px;
    }

    .mockup-container {
      width: 100%;
      max-width: 440px;
      transform: translate(5%, 10px);
    }

    .feature-row:hover .mockup-container {
      transform: translate(5%, 0px) scale(1.03);
    }

    .feature-desc {
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .left-title {
      font-size: 1.6rem;
    }

    .benefits-grid {
      max-width: 100%;
    }

    .benefit-item {
      padding: 24px 12px;
    }

    .feature-blob-wrapper {
      height: 280px;
    }

    .blob-circle {
      width: 200px;
      height: 200px;
    }

    .mockup-container {
      max-width: 320px;
    }
  }
</style>
