---
import { Image } from "astro:assets";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";

import imagen2 from "@/assets/images/maia_residuos/IMAGENES/IMAGEN 2.png";
import imagen3 from "@/assets/images/maia_residuos/IMAGENES/IMAGEN 3.png";
import imagen4 from "@/assets/images/maia_residuos/IMAGENES/IMAGEN 4.png";
import imagen5 from "@/assets/images/maia_residuos/IMAGENES/IMAGEN 5.png";

const functions = [
  {
    image: imagen2,
    alt: "Pantalla de Programación de Actividades en Maia Plagas",
    title: "Programación de Actividades",
    description: "Designa la fecha, hora, ubicación y operario para cada servicio.",
  },
  {
    image: imagen3,
    alt: "Sistema de Geolocalización",
    title: "Sistema de Geolocalización",
    description: "Monitorea la ubicación de tus vehículos en tiempo real.",
  },
  {
    image: imagen4,
    alt: "Monitorea la ubicación de tus vehículos en tiempo real.",
    title: "Monitorea la ubicación de tus vehículos en tiempo real.",
    description:
      "Genera rutas más eficientes según ubicación, distancia y recorrido para agilizar tus operaciones diarias.",
  },
  {
    image: imagen5,
    alt: "Emisión de Fichas de Control de Pesaje y Manifiestos",
    title: "Emisión de Fichas de Control de Pesaje y Manifiestos",
    description:
      "Emite documentación técnica de forma automática.",
  },
];
---

<section id="funciones" class="py-16 sm:py-24 lg:py-32 bg-white">
  <div class="w-full mx-auto px-[20px] sm:px-[45px] lg:px-[80px] max-w-[1800px]">

    <!-- Section Header -->
    <div class="mb-16 lg:mb-24">
      <h2
        class="text-2xl sm:text-3xl lg:text-[40px] font-extrabold text-[#15459c] uppercase tracking-wide"
        style="font-family: Poppins, sans-serif;"
      >
        FUNCIONES DE MAIA RESIDUOS
      </h2>
    </div>

    <!-- 2×2 Grid -->
    <div class="grid gap-16 lg:gap-24 sm:grid-cols-2">
      {
        functions.map((fn) => (
          <div class="flex flex-col items-center">
            <!-- Screenshot -->
            <div class="flex items-center justify-center w-full mb-8">
              <Image
                src={fn.image}
                alt={fn.alt}
                class="w-full h-auto object-contain"
              />
            </div>

            <!-- Text -->
            <div class="flex flex-col items-center text-center max-w-[550px]">
              <h3
                class="text-sm sm:text-base md:text-2xl font-bold text-[#1A1A2E] leading-snug mb-4"
                style="font-family: Poppins, sans-serif;"
              >
                {fn.title}
              </h3>
              <p class="text-[#4B5563] text-sm sm:text-base md:text-2xl leading-relaxed">
                {fn.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
