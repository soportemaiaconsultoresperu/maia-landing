---
import { Image } from "astro:assets";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";

import imagen2 from "@/assets/images/maia_plagas_saas/IMAGENES/IMAGEN 2.png";
import imagen3 from "@/assets/images/maia_plagas_saas/IMAGENES/IMAGEN 3.png";
import imagen4 from "@/assets/images/maia_plagas_saas/IMAGENES/IMAGEN 4.png";
import imagen5 from "@/assets/images/maia_plagas_saas/IMAGENES/IMAGEN 5.png";
---

<section id="descarga-app" class="py-12 sm:py-16 bg-white">
  <div class="container mx-auto max-w-[1200px] px-[20px] sm:px-[45px]">
    
    <!-- Banner Card -->
    <div class="relative rounded-[16px] overflow-hidden" style="background-color: #E8ECFC;">

      <!-- Content Row -->
      <div class="flex flex-col lg:flex-row items-center min-h-[180px]">

        <!-- LEFT: Worker + Phone images (stacked/overlapping) -->
        <div class="relative flex-shrink-0 w-full lg:w-auto flex items-end justify-center lg:justify-start" style="min-width: 320px; height: 220px;">
          <!-- Worker background photo -->
          <div class="absolute left-0 bottom-0 h-full overflow-hidden rounded-l-[16px]" style="width: 220px;">
            <Image
              src={imagen2}
              alt="Técnico de saneamiento usando la aplicación"
              class="h-full w-full object-cover object-center"
              style="mix-blend-mode: multiply; opacity: 0.9;"
            />
          </div>
          <!-- Phone mockup overlapping on the right -->
          <div class="absolute bottom-0 z-10" style="left: 140px; height: 210px;">
            <Image
              src={imagen3}
              alt="App Maia Plagas en el teléfono"
              class="h-full w-auto object-contain"
            />
          </div>
        </div>

        <!-- CENTER: App icon + name -->
        <div class="flex flex-col items-center justify-center px-6 py-6 lg:py-0 z-20 flex-shrink-0">
          <div class="w-[88px] h-[88px] rounded-[20px] overflow-hidden shadow-md mb-3">
            <Image
              src={imagen4}
              alt="Logo Maia Plagas App"
              class="w-full h-full object-contain"
            />
          </div>
          <span class="text-[15px] font-semibold text-[#1A1A2E] text-center" style="font-family: Poppins, sans-serif;">
            Maia Plagas
          </span>
        </div>

        <!-- RIGHT: Title + description + Google Play -->
        <div class="flex flex-col justify-center flex-1 px-6 py-8 lg:py-0 lg:pl-4 lg:pr-10">
          <h2
            class="text-[22px] sm:text-[26px] lg:text-[28px] font-extrabold text-[#311A6B] uppercase leading-tight mb-3"
            style="font-family: Poppins, sans-serif; letter-spacing: -0.3px;"
          >
            Descarga el App <span class="whitespace-nowrap">"Maia Plagas"</span>
          </h2>
          <p class="text-[#4B5563] text-[14px] sm:text-[15px] leading-relaxed mb-5 max-w-[320px]">
            Registra cada servicio y consulta información incluso sin conexión a internet.
          </p>
          <!-- Google Play Badge -->
          <a
            href="https://play.google.com/store"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block transition-opacity hover:opacity-80 active:opacity-60 w-fit"
            aria-label="Disponible en Google Play"
          >
            <Image
              src={imagen5}
              alt="Disponible en Google Play"
              class="h-[48px] w-auto object-contain"
            />
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
