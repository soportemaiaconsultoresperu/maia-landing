---
import { Image } from "astro:assets";
import heroBackground from "@/assets/images/maia_residuos/IMAGENES/IMAGEN 1.png";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/900.css";
---

<section
  id="inicio"
  class="relative min-h-[750px] lg:h-[calc(100vh-100px)] flex items-center overflow-hidden bg-slate-900"
>
  <!-- Background Image & Gradient Overlays -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroBackground}
      alt="Maia Plagas Software"
      class="w-full h-full object-cover object-right lg:object-center"
      quality="max"
      loading="eager"
    />
    <!-- Solid Blue Gradient Overlay - Stronger on left for absolute readability, fades to transparent on the right -->
    <!-- <div
      class="absolute inset-0 bg-gradient-to-b from-[#004b93]/95 via-[#004b93]/85 to-[#004b93]/60 lg:bg-gradient-to-r lg:from-[#004b93]/95 lg:via-[#004b93]/70 lg:to-transparent"
    >
    </div> -->
  </div>

  <div
    class="container mx-auto max-w-[1344px] px-[20px] sm:px-[45px] relative z-10"
  >
    <div class="grid lg:grid-cols-12">
      <!-- Content Panel (Left Aligned) -->
      <div
        class="lg:col-span-6 flex flex-col justify-center text-left py-12 lg:py-0"
      >
        <!-- Small uppercase tag -->
        <span
          class="text-sm sm:text-base font-medium tracking-[0.1em] text-white/90 uppercase mb-3"
          style="font-family: Poppins, sans-serif;"
        >
          ¡EL NUEVO SOFTWARE DE GESTIÓN DE RESIDUOS SÓLIDOS!
        </span>

        <!-- Main Title -->
        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-bold text-white leading-[1.05] mb-6 tracking-tight"
          style="font-family: Poppins, sans-serif;"
        >
          Maia Residuos
        </h1>

        <!-- Subtitle -->
        <p
          class="text-sm sm:text-base md:text-2xl text-white/90 leading-relaxed mb-10 max-w-lg"
        >
          Cuenta con un software propio para tu empresa, diseñado para controlar
          tus operaciones, monitorear vehículos en tiempo real, optimizar rutas
          y generar manifiestos automáticamente.
        </p>

        <!-- Vertically Stacked Premium Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:max-w-[500px]">
          <!-- Button 2: Agendar Demo -->
          <a
            href="#contacto"
            class="flex-1 w-full inline-flex items-center justify-center bg-[#3dd87c] text-white font-bold text-lg px-8 py-3.5 rounded-[16px] hover:brightness-110 transition-all duration-300 uppercase tracking-wider hover:scale-[1.02] active:scale-95 shadow-lg shadow-[#60e8c1]/10 text-center"
            style="font-family: Poppins, sans-serif;"
          >
            Agendar Demo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Subtle load-in animations for a premium feel */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h1,
  span,
  p,
  div.flex {
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  span {
    animation-delay: 0.1s;
  }
  h1 {
    animation-delay: 0.25s;
  }
  p {
    animation-delay: 0.4s;
  }
  div.flex {
    animation-delay: 0.55s;
  }
</style>
