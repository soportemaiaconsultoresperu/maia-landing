---
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";
---

<section
  id="faq-section"
  class="py-16 sm:py-24 bg-white relative overflow-hidden"
>
  <div class="container mx-auto px-6 sm:px-12 lg:px-20 max-w-7xl relative z-10">
    <!-- Section Title -->
    <h2
      class="text-center text-2xl sm:text-3xl md:text-[34px] font-extrabold text-[#1d1b84] mb-12 tracking-wide"
      style="font-family: Poppins, sans-serif;"
    >
      Preguntas Frecuentes
    </h2>

    <!-- Accordion Wrapper -->
    <div class="space-y-6">
      <!-- FAQ Item 1 -->
      <div
        class="faq-item border-[1.5px] border-[#d8dbf5] rounded-[18px] overflow-hidden transition-all duration-300 bg-white"
      >
        <button
          class="faq-trigger w-full flex items-center justify-between gap-4 px-6 py-5 bg-[#eef2ff] hover:bg-[#e0e7ff] transition-colors duration-200 text-left"
          aria-expanded="false"
        >
          <span
            class="text-base sm:text-lg md:text-[19px] font-bold text-[#0c1833] leading-snug"
            style="font-family: Poppins, sans-serif;"
          >
            ¿Qué significa ppm en una dilución?
          </span>
          <svg
            class="faq-arrow h-4 w-4 text-[#0c1833] transition-transform duration-300 shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 16L6 10H18L12 16Z"></path>
          </svg>
        </button>
        <div
          class="faq-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-white"
        >
          <div
            class="px-6 py-6 border-t border-[#d8dbf5] text-[#2d3748]  leading-relaxed space-y-4"
          >
            <p>
              Partes por millón (ppm) es una unidad de volumen y expresa cuántos
              miligramos de soluto se encuentra en un litro de solvente.
            </p>
            <p>
              Ejemplo práctico: Si una solución tiene 200 ppm de hipoclorito de
              sodio (cloro), significa que hay 200 miligramos de cloro en 1
              litro de agua.
            </p>
            <p>
              ¿Cómo calcular ppm fácilmente? Emplea nuestro conversor de
              diluciones para obtener la cantidad exacta de producto que debes
              usar.
            </p>
          </div>
        </div>
      </div>

      <!-- FAQ Item 2 -->
      <div
        class="faq-item border-[1.5px] border-[#d8dbf5] rounded-[18px] overflow-hidden transition-all duration-300 bg-white"
      >
        <button
          class="faq-trigger w-full flex items-center justify-between gap-4 px-6 py-5 bg-[#eef2ff] hover:bg-[#e0e7ff] transition-colors duration-200 text-left"
          aria-expanded="false"
        >
          <span
            class="text-base sm:text-lg md:text-[19px] font-bold text-[#0c1833] leading-snug"
            style="font-family: Poppins, sans-serif;"
          >
            ¿Qué es el Hipoclorito de Sodio y para que se utiliza?
          </span>
          <svg
            class="faq-arrow h-4 w-4 text-[#0c1833] transition-transform duration-300 shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 16L6 10H18L12 16Z"></path>
          </svg>
        </button>
        <div
          class="faq-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-white"
        >
          <div
            class="px-6 py-6 border-t border-[#d8dbf5] text-[#2d3748] text-sm sm:text-base md:text-2xl leading-relaxed space-y-4"
          >
            <p>
              El hipoclorito de sodio (NaClO) es un compuesto químico con
              propiedades desinfectantes y blanqueadoras. Se usa ampliamente en
              saneamiento ambiental, limpieza industrial y potabilización del
              agua.
            </p>
            <div class="">
              <strong class="block text-[#0c1833] mb-2 text-sm sm:text-base md:text-2xl"
                >Usos principales:</strong
              >
              <ul class="list-disc pl-5 space-y-1.5 text-sm sm:text-base md:text-2xl">
                <li>
                  Eliminación de bacterias, virus y hongos en superficies.
                </li>
                <li>Desinfección de agua potable y piscinas.</li>
                <li>
                  Control de malos olores y biofilms en la industria
                  alimentaria.
                </li>
              </ul>
            </div>
            <div>
              <strong class="block text-[#0c1833] mb-2 text-sm sm:text-base md:text-xl">Precaución:</strong>
              <ul class="list-disc pl-5 space-y-1.5 text-sm sm:text-base md:text-2xl">
                <li>
                  Siempre diluir correctamente según las indicaciones del
                  fabricante.
                </li>
                <li>
                  No mezclar con otros químicos como amoniaco (puede generar
                  gases tóxicos).
                </li>
                <li>Usar equipo de protección al manipularlo.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Item 3 -->
      <div
        class="faq-item border-[1.5px] border-[#d8dbf5] rounded-[18px] overflow-hidden transition-all duration-300 bg-white"
      >
        <button
          class="faq-trigger w-full flex items-center justify-between gap-4 px-6 py-5 bg-[#eef2ff] hover:bg-[#e0e7ff] transition-colors duration-200 text-left"
          aria-expanded="false"
        >
          <span
            class="text-base sm:text-lg md:text-[19px] font-bold text-[#0c1833] leading-snug"
            style="font-family: Poppins, sans-serif;"
          >
            ¿Porqué es importante utilizar productos certificados?
          </span>
          <svg
            class="faq-arrow h-4 w-4 text-[#0c1833] transition-transform duration-300 shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 16L6 10H18L12 16Z"></path>
          </svg>
        </button>
        <div
          class="faq-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-white"
        >
          <div
            class="px-6 py-6 border-t border-[#d8dbf5] text-[#2d3748] text-sm sm:text-base md:text-2xl leading-relaxed space-y-4"
          >
            <p>
              El uso de productos certificados garantiza seguridad, efectividad
              y cumplimiento de las normativas sanitarias.
            </p>
            <div>
              <strong class="block text-[#0c1833] mb-2"
                >Ventajas de los productos certificados:</strong
              >
              <ul class="list-disc pl-5 space-y-1.5">
                <li>Eficacia comprobada: Avalados por estudios científicos.</li>
                <li>Seguridad para la salud: Reducción de riesgos tóxicos.</li>
                <li>
                  Cumplimiento normativo: Aprobados por entidades sanitarias
                  como el MINSA o la OMS.
                </li>
                <li>
                  Menor impacto ambiental: Fórmulas biodegradables o con menor
                  carga química.
                </li>
              </ul>
            </div>
            <div>
              <strong class="block text-[#0c1833] mb-2"
                >Riesgos de usar productos sin certificación:</strong
              >
              <ul class="list-disc pl-5 space-y-1.5">
                <li>Pueden no ser efectivos contra ciertos patógenos.</li>
                <li>Pueden contener sustancias nocivas no reguladas.</li>
                <li>
                  Pueden generar problemas legales o multas en inspecciones
                  sanitarias.
                </li>
              </ul>
            </div>
            <p class="pt-2 text-[#0c1833]">
              <strong>Recuerda:</strong> Antes de comprar, revisa si el producto tiene
              registro sanitario y está autorizado por organismos oficiales.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupFAQ() {
    const faqItems = document.querySelectorAll(".faq-item");

    faqItems.forEach((item) => {
      const trigger = item.querySelector(".faq-trigger");
      const panel = item.querySelector(".faq-panel") as HTMLElement;
      const arrow = item.querySelector(".faq-arrow");

      if (!trigger || !panel) return;

      trigger.addEventListener("click", () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";

        // Close other items
        faqItems.forEach((otherItem) => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector(".faq-trigger");
            const otherPanel = otherItem.querySelector(
              ".faq-panel",
            ) as HTMLElement;
            const otherArrow = otherItem.querySelector(".faq-arrow");

            if (otherTrigger)
              otherTrigger.setAttribute("aria-expanded", "false");
            if (otherPanel) otherPanel.style.maxHeight = "0";
            if (otherArrow) otherArrow.classList.remove("rotate-180");
            otherItem.classList.remove(
              "shadow-lg",
              "shadow-[#5059e5]/10",
              "border-[#a5b4fc]",
            );
          }
        });

        // Toggle current item
        if (isExpanded) {
          trigger.setAttribute("aria-expanded", "false");
          panel.style.maxHeight = "0";
          if (arrow) arrow.classList.remove("rotate-180");
          item.classList.remove(
            "shadow-lg",
            "shadow-[#5059e5]/10",
            "border-[#a5b4fc]",
          );
        } else {
          trigger.setAttribute("aria-expanded", "true");
          panel.style.maxHeight = panel.scrollHeight + "px";
          if (arrow) arrow.classList.add("rotate-180");
          item.classList.add(
            "shadow-lg",
            "shadow-[#5059e5]/10",
            "border-[#a5b4fc]",
          );
        }
      });
    });
  }

  // Initialize
  setupFAQ();
  // Listen for view transitions if using Astro’s Router
  document.addEventListener("astro:after-swap", setupFAQ);
</script>
