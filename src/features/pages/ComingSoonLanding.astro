---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";

interface Feature {
  title: string;
  description: string;
  iconSvg: string;
}

interface Props {
  badge: string;
  title: string;
  subtitle: string;
  description: string;
  features: Feature[];
  projectId: string; // Used to identify form submissions and give unique IDs
}

const { badge, title, subtitle, description, features, projectId } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-b from-white via-slate-50/50 to-white py-20 lg:py-28 font-sans">
  <!-- Brand Blur Elements -->
  <div class="absolute -left-40 top-1/4 -z-10 h-96 w-96 rounded-full bg-brand-blue/5 blur-3xl"></div>
  <div class="absolute -right-40 top-10 -z-10 h-[500px] w-[500px] rounded-full bg-brand-green/10 blur-3xl"></div>

  <!-- Decorative Grid Grid -->
  <div class="absolute inset-0 -z-20 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-y-16 lg:grid-cols-2 lg:gap-x-16">
      
      <!-- Text & Form Column -->
      <div class="flex flex-col space-y-8">
        <div>
          <!-- Badge -->
          <span class="inline-flex items-center rounded-full bg-brand-blue/5 px-4 py-1.5 text-xs sm:text-sm font-semibold tracking-wider text-brand-blue uppercase ring-1 ring-inset ring-brand-blue/10 animate-pulse">
            {badge}
          </span>
          
          <!-- Heading -->
          <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
            {title}
            <span class="block bg-gradient-to-r from-brand-blue to-brand-blue/80 bg-clip-text text-transparent text-3xl sm:text-4xl lg:text-5xl mt-2 font-semibold">
              {subtitle}
            </span>
          </h1>
          
          <!-- Description -->
          <p class="mt-6 text-base sm:text-lg leading-relaxed text-slate-600">
            {description}
          </p>
        </div>

        <!-- Notification Form -->
        <div class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white/70 p-6 shadow-xl shadow-slate-100/50 backdrop-blur-md">
          <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-brand-green/20 blur-xl"></div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-2">¿Quieres enterarte del lanzamiento?</h3>
          <p class="text-sm text-slate-500 mb-4">Déjanos tu correo y sé uno de los primeros en acceder cuando estemos listos.</p>

          <form id={`notify-form-${projectId}`} class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-grow">
              <input
                type="email"
                required
                id={`email-input-${projectId}`}
                placeholder="Tu correo electrónico"
                class="w-full rounded-xl border border-slate-200 bg-white/90 px-4 py-3 text-sm text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/10"
              />
            </div>
            <button
              type="submit"
              class="relative flex items-center justify-center rounded-xl bg-brand-blue px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-brand-blue/95 hover:shadow-lg hover:shadow-brand-blue/10 active:scale-95 disabled:pointer-events-none disabled:opacity-50"
            >
              <span>Notificarme</span>
            </button>
          </form>

          <!-- Success State -->
          <div id={`success-msg-${projectId}`} class="hidden flex items-start gap-3 mt-2 rounded-xl bg-teal-50 border border-teal-100 p-4 text-teal-800 transition-all duration-300">
            <svg class="h-5 w-5 text-teal-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="font-semibold text-sm">¡Registro exitoso!</p>
              <p class="text-xs text-teal-700/90 mt-0.5">Te avisaremos tan pronto como este servicio esté disponible.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Graphics / Preview Column -->
      <div class="relative flex items-center justify-center lg:pl-10">
        <!-- Floating shapes & mockup -->
        <div class="relative w-full max-w-[480px] aspect-[4/3] rounded-2xl border border-slate-100 bg-gradient-to-tr from-brand-blue/5 to-brand-green/5 p-6 shadow-2xl shadow-slate-100 flex flex-col justify-center items-center text-center overflow-hidden">
          <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
          
          <!-- Animated gear / compass icon -->
          <div class="relative mb-6 flex h-24 w-24 items-center justify-center rounded-2xl bg-white shadow-xl shadow-brand-blue/5 ring-1 ring-slate-100">
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-brand-blue to-brand-green opacity-[0.08]"></div>
            <svg class="h-12 w-12 text-brand-blue animate-[spin_10s_linear_infinite]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>

          <h4 class="text-xl font-bold text-slate-800">Sección en Construcción</h4>
          <p class="mt-2 text-sm text-slate-500 max-w-[280px]">Estamos programando y puliendo los detalles finales de esta plataforma.</p>
          
          <div class="mt-6 flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Desarrollo Activo</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Features Section -->
    <div class="mt-24 border-t border-slate-100 pt-16">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <div class="group relative rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-blue/10">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/5 text-brand-blue transition-colors group-hover:bg-brand-blue group-hover:text-white">
              <Fragment set:html={feature.iconSvg} />
            </div>
            <h4 class="mt-4 text-lg font-bold text-slate-900 group-hover:text-brand-blue transition-colors">
              {feature.title}
            </h4>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ projectId }}>
  (() => {
    const form = document.getElementById(`notify-form-${projectId}`);
    const successMsg = document.getElementById(`success-msg-${projectId}`);
    const emailInput = document.getElementById(`email-input-${projectId}`);
    const scriptUrl = 'https://script.google.com/macros/s/AKfycbxChjOsML3etbRHgT4Dvm7UwrigFoQdU6u8ea8p1ezPNBlJW6mtriIK4UW033ZlNPL2DQ/exec';

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      if (!submitBtn) return;
      
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Enviando...</span>
      `;
      submitBtn.disabled = true;

      try {
        const data = {
          email: emailInput?.value || '',
          project: `Coming Soon - ${projectId}`
        };

        await fetch(scriptUrl, {
          method: 'POST',
          body: JSON.stringify(data),
          headers: {
            'Content-Type': 'text/plain;charset=utf-8',
          }
        });

        form.classList.add('hidden');
        if (successMsg) successMsg.classList.remove('hidden');
      } catch (error) {
        console.error('Error enviando formulario:', error);
        // Fallback display success message even on CORS block of standard fetch, but log
        form.classList.add('hidden');
        if (successMsg) successMsg.classList.remove('hidden');
      }
    });
  })();
</script>
