---
import { Image } from "astro:assets";

// Images
import imgInformes from "@/assets/images/saneamiento_ambiental/IMAGENES/ELABORACION DE INFORMES.png";
import imgEmpresa from "@/assets/images/saneamiento_ambiental/IMAGENES/FORMULACION DE UNA EMPRESA.png";
import imgPlagas from "@/assets/images/saneamiento_ambiental/IMAGENES/ESTUDIO DE PROFUNDIDAD DE PLAGAS.png";
import imgFosfuro from "@/assets/images/saneamiento_ambiental/IMAGENES/USO DE FOSFURO.png";

// Icons
import iconDoc from "@/assets/images/saneamiento_ambiental/ICONOS/1.png";
import iconCheck from "@/assets/images/saneamiento_ambiental/ICONOS/2.png";
import iconSearch from "@/assets/images/saneamiento_ambiental/ICONOS/3.png";
import iconWorker from "@/assets/images/saneamiento_ambiental/ICONOS/4.png";

const asesorias = [
  {
    title: "Elaboración de Informes Técnicos para Saneamiento Ambiental",
    image: imgInformes,
    icon: iconDoc,
    iconBg: "bg-[#00af9b]", // Teal/cyan
    borderColor: "border-[#00af9b]",
    description: "Aprende a realizar reportes, fichas técnicas e informes de alta calidad para tus clientes, de acuerdo a los estándares de las diferentes normativas: BRC, IFS, ISO 22 000, entre otros.",
    listTitle: "Asesoramos:",
    points: [
      "Diagnóstico preciso de fallas y riesgos sanitarios.",
      "Plan de acción para mejorar procesos.",
      "Lineamientos para cumplir normativas y avanzar hacia certificaciones."
    ]
  },
  {
    title: "Formalización de una Empresa de Saneamiento Ambiental",
    image: imgEmpresa,
    icon: iconCheck,
    iconBg: "bg-[#22c55e]", // Green
    borderColor: "border-[#22c55e]",
    description: "Evaluamos las condiciones sanitarias de tu empresa para detectar riesgos, incumplimientos y oportunidades de mejora, con el fin de facilitar su acreditación ante el ente regulador.",
    listTitle: "Incluye:",
    points: [
      "Asesoría legal y normativa para el registro y autorización de la empresa.",
      "Elaboración de memorias descriptivas y plan de contingencia.",
      "Capacitación en normativas vigentes y mejores prácticas para garantizar el cumplimiento regulatorio."
    ]
  },
  {
    title: "Estudio de profundidad en Manejo Integrado de Plagas",
    image: imgPlagas,
    icon: iconSearch,
    iconBg: "bg-[#ffb703]", // Orange
    borderColor: "border-[#ffb703]",
    description: "Analizamos el entorno de tu empresa para detectar factores que favorecen la aparición de plagas con el fin de diseñar estrategias preventivas.",
    listTitle: "Incluye:",
    points: [
      "Diagnóstico de condiciones estructurales y sanitarias.",
      "Identificación de factores de riesgo y puntos críticos.",
      "Evaluación del comportamiento y presencia de plagas.",
      "Propuesta de estrategias de control preventivo y correctivo."
    ]
  }
];

const capacitacion = {
  title: "Uso de Fosfuro de Aluminio en Almacenamiento de Granos",
  image: imgFosfuro,
  icon: iconWorker,
  iconBg: "bg-[#6366f1]", // Purple/blue
  borderColor: "border-[#6366f1]",
  description: "Ofrecemos capacitación especializada en el uso seguro y eficaz del Fosfuro de Aluminio para el control de plagas en el almacenamiento de granos. Este curso cubre desde la preparación y aplicación del fumigante hasta las medidas de seguridad necesarias para proteger la salud del personal y garantizar la integridad del producto almacenado.",
  listTitle: "Implementamos:",
  points: [
    "Métodos seguros de aplicación de Fosfuro de Aluminio.",
    "Prevención de riesgos y protocolos de seguridad.",
    "Cumplimiento de normativas sanitarias y ambientales.",
    "Control y monitoreo de plagas en almacenamiento de granos."
  ]
};
---

<section id="servicios" class="py-20 bg-white">
  <div class="container mx-auto px-6 lg:px-16 max-w-7xl">
    
    <!-- ASESORÍAS SECTION -->
    <div class="mb-12">
      <div class="flex items-center gap-4 mb-10">
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#153f70] tracking-tight uppercase shrink-0">
          ASESORÍAS
        </h2>
        <div class="h-[2px] bg-[#153f70]/30 flex-grow relative">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-[#153f70] rounded-full"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {asesorias.map((item) => (
          <div class={`bg-[#f8f9fa] rounded-2xl overflow-hidden shadow-md flex flex-col justify-between border-b-[6px] ${item.borderColor} transition-all duration-300 hover:shadow-xl`}>
            <div>
              <!-- Image Container with overlapping Icon -->
              <div class="relative h-56 w-full">
                <Image 
                  src={item.image} 
                  alt={item.title} 
                  class="w-full h-full object-cover"
                />
                <div class={`absolute -bottom-6 left-6 w-12 h-12 rounded-xl ${item.iconBg} flex items-center justify-center shadow-lg border-2 border-white`}>
                  <Image src={item.icon} alt="Icon" class="w-6 h-6 object-contain invert brightness-0" />
                </div>
              </div>

              <!-- Content -->
              <div class="px-6 pt-10 pb-6">
                <h3 class="text-2xl font-bold text-[#153f70] mb-4 text-center min-h-[56px] flex items-center justify-center">
                  {item.title}
                </h3>
                
                <p class="text-gray-650 text-2xl  mb-6  text-gray-600">
                  {item.description}
                </p>

                <div class="space-y-2 text-2xl text-gray-700">
                  <p class="font-bold text-gray-800">{item.listTitle}</p>
                  <ul class="space-y-2 list-none pl-1">
                    {item.points.map((point) => (
                      <li class="flex items-start gap-2">
                        <span class="text-gray-400 mt-1 shrink-0">•</span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Button at the bottom -->
            <div class="px-6 pb-8 pt-2 flex justify-center w-full">
              <a 
                href="#contacto" 
                class="w-full inline-flex items-center justify-center px-6 py-2.5 bg-[#00af9b] hover:bg-[#009685] text-white font-bold text-md tracking-wider rounded-full transition-all duration-300 shadow-md uppercase"
              >
                COTIZAR SERVICIO
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CAPACITACIONES SECTION -->
    <div class="mt-20">
      <div class="flex items-center gap-4 mb-10">
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#153f70] tracking-tight uppercase shrink-0">
          CAPACITACIONES
        </h2>
        <div class="h-[2px] bg-[#153f70]/30 flex-grow relative">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-[#153f70] rounded-full"></div>
        </div>
      </div>

      <!-- Horizontal Card Layout -->
      <div class={`bg-[#f8f9fa] rounded-2xl overflow-hidden shadow-md border-b-[6px] ${capacitacion.borderColor} transition-all duration-300 hover:shadow-xl`}>
        <div class="grid grid-cols-1 lg:grid-cols-12">
          
          <!-- Image side (left) -->
          <div class="lg:col-span-5 h-64 lg:h-auto min-h-[300px] relative">
            <Image 
              src={capacitacion.image} 
              alt={capacitacion.title} 
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Content side (right) -->
          <div class="lg:col-span-7 p-8 lg:p-12 flex flex-col justify-between">
            <div>
              <!-- Header with Icon & Title side-by-side -->
              <div class="flex items-center gap-4 mb-6">
                <div class={`w-12 h-12 rounded-xl ${capacitacion.iconBg} flex items-center justify-center shadow-lg shrink-0`}>
                  <Image src={capacitacion.icon} alt="Icon" class="w-6 h-6 object-contain invert brightness-0" />
                </div>
                <h3 class="text-2xl font-bold text-[#153f70]">
                  {capacitacion.title}
                </h3>
              </div>

              <!-- Description -->
              <p class="text-gray-650 text-2xl  mb-6 text-gray-600">
                {capacitacion.description}
              </p>

              <!-- Points List -->
              <div class="space-y-2 text-2xl text-gray-700 mb-8">
                <p class="font-bold text-gray-800">{capacitacion.listTitle}</p>
                <ul class="space-y-2 list-none pl-1">
                  {capacitacion.points.map((point) => (
                    <li class="flex items-start gap-2">
                      <span class="text-gray-400 mt-1 shrink-0">•</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Button -->
            <div class="flex justify-center lg:justify-start w-full">
              <a 
                href="#contacto" 
                class="w-full inline-flex items-center justify-center px-8 py-3 bg-[#00af9b] hover:bg-[#009685] text-white font-bold text-md tracking-wider rounded-full transition-all duration-300 shadow-md uppercase"
              >
                COTIZAR SERVICIO
              </a>
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</section>

