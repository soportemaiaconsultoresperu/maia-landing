---
import { Image } from "astro:assets";

// Image
import imgCapacitaciones from "@/assets/images/saneamiento_ambiental/IMAGENES/CAPACITACIONES ESPECIALIZADAS.png";

// Icons
import iconHouse from "@/assets/images/saneamiento_ambiental/ICONOS/5.png";
import iconCases from "@/assets/images/saneamiento_ambiental/ICONOS/6.png";
import iconCert from "@/assets/images/saneamiento_ambiental/ICONOS/7.png";

const topics = [
  "Manejo Integrado de Plagas (MIP).",
  "Control de Roedores.",
  "Control de Insectos.",
  "Desinfección de Ambientes.",
  "Limpieza de Reservorios de Agua, Trampas de Grasa y Pozos Sépticos.",
  "Limpieza de Campanas Extractoras.",
  "Control Aviar.",
  "Manejo de Residuos Peligrosos.",
];
---

<section class="py-16 md:py-24 bg-white overflow-visible">
  <!-- Hero Box with Background Image (Spans full viewport width) -->
  <div
    class="relative w-full min-h-[550px] lg:h-[700px] overflow-hidden flex items-center"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <Image
        src={imgCapacitaciones}
        alt="Capacitaciones Especializadas para Empresas y Profesionales"
        class="w-full h-full object-cover object-[75%_center]"
        quality="max"
      />
      <!-- Mobile/Tablet Overlay (darker green/teal gradient) -->
      <div
        class="absolute inset-0 bg-gradient-to-br from-[#014737]/95 via-[#0c5946]/95 to-[#007a6c]/90 lg:hidden z-10"
      >
      </div>
    </div>

    <!-- Desktop Slanted Overlay (uncommented and active) -->
    <!-- <div 
      class="hidden lg:block absolute inset-0 z-10 bg-gradient-to-r from-[#014737]/95 via-[#097155]/95 to-[#12916b]/90"
      style="clip-path: polygon(0 0, 62% 0, 50% 100%, 0 100%);"
    ></div> -->

    <!-- Centered Content Container -->
    <div class="container mx-auto px-6 lg:px-16 max-w-7xl relative z-20 w-full">
      <div class="max-w-xl text-white">
        <h3
          class="text-3xl lg:text-[38px] font-bold leading-[1.2] mb-6 tracking-tight"
        >
          Capacitaciones Especializadas para Empresas y Profesionales
        </h3>

        <p class="text-sm md:text-2xl text-white/90 leading-relaxed mb-8">
          Ofrecemos cursos y talleres en saneamiento ambiental, seguridad
          alimentaria y normativas internacionales, con metodologías dinámicas y
          aplicativas.
        </p>

        <div>
          <h4
            class="font-bold text-sm md:text-lg text-white mb-4 uppercase tracking-wider"
          >
            Temas:
          </h4>
          <ul class="space-y-2.5 text-lg text-white/90">
            {
              topics.map((topic) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-white mt-2 shrink-0" />
                  <span>{topic}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Overlapping Info Bar (centered container) -->
  <div class="relative z-30 -mt-10 px-6 lg:px-16 max-w-7xl mx-auto">
    <div
      class="bg-[#f5f6f7] rounded-3xl md:rounded-[40px] shadow-xl border border-gray-100/50 p-6 md:py-8 md:px-10 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-center"
    >
      <!-- Feature 1 -->
      <div class="flex items-center gap-4">
        <div
          class="w-14 h-14 rounded-full bg-[#00af9b] flex items-center justify-center text-white shrink-0 shadow-lg shadow-[#00af9b]/25"
        >
          <Image
            src={iconHouse}
            alt="Capacitación in-house"
            class="w-6 h-6 object-contain invert brightness-0"
          />
        </div>
        <div>
          <p class="font-bold text-[#153f70] text-base md:text-lg leading-snug">
            Capacitación in-house o en modalidad abierta.
          </p>
        </div>
      </div>

      <!-- Feature 2 -->
      <div
        class="flex items-center gap-4 border-t border-gray-200/50 pt-6 md:pt-0 md:border-t-0 md:border-x md:px-6 lg:px-8 border-dashed"
      >
        <div
          class="w-14 h-14 rounded-full bg-[#f7941d] flex items-center justify-center text-white shrink-0 shadow-lg shadow-[#f7941d]/25"
        >
          <Image
            src={iconCases}
            alt="Casos reales"
            class="w-6 h-6 object-contain invert brightness-0"
          />
        </div>
        <div>
          <p class="font-bold text-[#153f70] text-base md:text-lg leading-snug">
            Aplicación de casos reales en la industria.
          </p>
        </div>
      </div>

      <!-- Feature 3 -->
      <div
        class="flex items-center gap-4 border-t border-gray-200/50 pt-6 md:pt-0 md:border-t-0"
      >
        <div
          class="w-14 h-14 rounded-full bg-[#70b243] flex items-center justify-center text-white shrink-0 shadow-lg shadow-[#70b243]/25"
        >
          <Image
            src={iconCert}
            alt="Certificación experta"
            class="w-6 h-6 object-contain invert brightness-0"
          />
        </div>
        <div>
          <p class="font-bold text-[#153f70] text-base md:text-lg leading-snug">
            Certificación avalada por expertos en el sector.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
