---
import BaseLayout from "./BaseLayout.astro";
import type { SEO } from "@/types/seo";

interface Props {
  seo?: Partial<SEO>;
  title: string;
  description?: string;
}
---

<BaseLayout
  seo={{ ...Astro.props.seo, type: "article" }}
  title={Astro.props.title}
  description={Astro.props.description}
>
  <main>
    <article>
      <slot />
    </article>
  </main>
</BaseLayout>
