---
import MaiaResiduosFooter from "@/components/website/MaiaResiduosFooter.astro";
import BaseLayout from "./BaseLayout.astro";
import MaiaResiduosHeader from "@/components/website/MaiaResiduosHeader.astro";
import type { SEO } from "@/types/seo";

interface Props {
  seo?: Partial<SEO>;
  title?: string;
  description?: string;
}
---

<BaseLayout seo={Astro.props.seo} title={Astro.props.title} description={Astro.props.description}>
  <MaiaResiduosHeader />
  <main class="min-h-screen bg-slate-50/50">
    <slot />
  </main>
  <MaiaResiduosFooter />
</BaseLayout>
