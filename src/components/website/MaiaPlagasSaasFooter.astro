---
import { Image } from "astro:assets";
import logoMaia from "@/assets/images/maia_plagas_saas/logo_white.png";
import iconWsp from "@/assets/images/WSP.png";
import iconCorreo from "@/assets/images/CORREO.png";
import iconFb from "@/assets/images/FB.png";
import iconIg from "@/assets/images/IG.png";
import iconTk from "@/assets/images/TK.png";
import iconIn from "@/assets/images/IN.png";
---

<footer class="bg-[#1e242a] text-white pt-16 pb-8 px-4 md:px-8 lg:px-16 font-sans">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Left Column -->
      <div class="flex flex-col space-y-6">
        <Image src={logoMaia} alt="Maia Consultores" class="h-24 w-auto object-contain object-left" />
        <p class="text-gray-300 text-sm leading-relaxed max-w-sm">
          Especialistas en asesoría, capacitación y desarrollo de software para empresas de saneamiento ambiental, gestión de residuos e industria alimentaria.
        </p>
      </div>

      <!-- Services Columns -->
      <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-8">
        <!-- Consultoría / Software -->
        <div class="space-y-8">
          <div>
            <h3 class="font-bold text-lg mb-4">SERVICIOS</h3>
            <h4 class="font-bold text-base mb-3 text-white/90">Consultoría</h4>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li><a href="/inocuidad-calidad" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Calidad e Inocuidad</a></li>
              <li><a href="/saneamiento" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Saneamiento Ambiental</a></li>
              <li><a href="/proyectos-innovate" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Proyecto Innóvate</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="font-bold text-base mb-3 text-white/90">Software</h4>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li><a href="/maiaplagas" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Maia Plagas</a></li>
              <li><a href="/maiaplagaslicencia" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Maia Plagas Licencia</a></li>
              <li><a href="/maiaresiduos" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Maia Residuos</a></li>
              <li><a href="/maiabusiness" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Maia Business</a></li>
              <li><a href="/maiabusiness" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Desarrollo de software</a></li>
            </ul>
          </div>
        </div>

        <!-- Formación / Otros -->
        <div class="space-y-8 sm:pt-11">
          <div>
            <h4 class="font-bold text-base mb-3 text-white/90">Formación</h4>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li><a href="/cursos" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Cursos</a></li>
              <li><a href="/cursos/aula-virtual" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Aula Virtual</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-base mb-3 text-white/90">Otros</h4>
            <ul class="space-y-2 text-gray-300 text-sm">
              <li><a href="/calculadora" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Calculadora de diluciones</a></li>
              <li><a href="/blog" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Blog</a></li>
              <li><a href="/politica-privacidad" class="hover:text-white transition-colors">Política de Privacidad</a></li>
              <li><a href="/condiciones-servicio" class="hover:text-white transition-colors">Condiciones del Servicio</a></li>
              <li><a href="/eliminacion-datos" class="hover:text-white transition-colors">Eliminación de Datos</a></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="space-y-8">
        <div>
          <h3 class="font-bold text-lg mb-4">CONTACTO</h3>
          <ul class="space-y-4 text-gray-300 text-sm">
            <li class="flex items-center space-x-3">
              <Image src={iconWsp} alt="WhatsApp" class="w-5 h-5 object-contain filter invert opacity-90" />
              <span>+51 945 144 134</span>
            </li>
            <li class="flex items-center space-x-3">
              <Image src={iconWsp} alt="WhatsApp" class="w-5 h-5 object-contain filter invert opacity-90" />
              <span>+51 917 305 984</span>
            </li>
            <li class="flex items-center space-x-3">
              <Image src={iconCorreo} alt="Email" class="w-5 h-5 object-contain filter invert opacity-90" />
              <span>asesor3@maiaplagasperu.com</span>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-bold text-lg mb-4">SÍGUENOS</h3>
          <div class="flex space-x-4">
            <a href="#" target="_blank" rel="noopener noreferrer" class="block w-10 h-10 flex items-center justify-center">
              <Image src={iconTk} alt="TikTok" class="w-10 h-10 object-contain filter " />
            </a>
            <a href="https://www.facebook.com/maiaconsultoresperu/" target="_blank" rel="noopener noreferrer" class="block w-10 h-10 flex items-center justify-center">
              <Image src={iconFb} alt="Facebook" class="w-10 h-10 object-contain filter " />
            </a>
            <a href="https://www.instagram.com/maiaconsultoresperu/" target="_blank" rel="noopener noreferrer" class="block w-10 h-10 flex items-center justify-center">
              <Image src={iconIg} alt="Instagram" class="w-10 h-10 object-contain filter " />
            </a>
            <a href="https://www.linkedin.com/company/maia-consultores-peru/?originalSubdomain=pe" target="_blank" rel="noopener noreferrer" class="block w-10 h-10 flex items-center justify-center">
              <Image src={iconIn} alt="LinkedIn" class="w-10 h-10 object-contain filter " />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-16 pt-8 border-t border-gray-700/50 flex flex-col md:flex-row justify-between items-center text-gray-400 text-sm gap-4">
      <p>© 2026 MAIA Consultores - Todos los derechos reservados</p>
      <div class="flex flex-wrap justify-center gap-4 text-xs">
        <a href="/politica-privacidad" class="hover:text-white transition-colors">Política de Privacidad</a>
        <span class="text-gray-600">•</span>
        <a href="/condiciones-servicio" class="hover:text-white transition-colors">Condiciones del Servicio</a>
        <span class="text-gray-600">•</span>
        <a href="/eliminacion-datos" class="hover:text-white transition-colors">Eliminación de Datos</a>
      </div>
    </div>
  </div>
</footer>
