---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import logoMaiaPlagas from "@/assets/images/maia_plagas_saas/LOGO MAIA PLAGAS.png";

const navItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Funciones", href: "#funciones" },
  { label: "Precios", href: "#precios" },
  { label: "Clientes", href: "#clientes" },
];
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/90 backdrop-blur-md shadow-sm">
  <div
    class="mx-auto flex min-h-[100px] w-full max-w-[1344px] items-center justify-between px-[20px] sm:px-[45px] lg:h-[100px]"
  >
    <!-- Logo -->
    <a href="/maiaplagas" aria-label="Maia Plagas SaaS" class="shrink-0 flex items-center">
      <img
        src={logoMaiaPlagas.src}
        alt="Maia Plagas SaaS Logo"
        class="h-[60px] w-auto sm:h-[68px] md:h-[75px] transition-transform duration-300 hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav
      aria-label="Plagas SaaS"
      class="hidden items-center gap-x-8 lg:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-[16px] font-medium leading-none tracking-tight text-[#334155] transition-all duration-300 hover:text-[#153f70]"
            style="font-family: Poppins, sans-serif;"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA Buttons -->
    <div class="hidden lg:flex items-center gap-x-3">
      <a
        href="https://play.google.com/store"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center border border-slate-200 bg-slate-50 hover:bg-slate-100 active:bg-slate-200 px-5 py-2.5 text-[14px] font-semibold text-slate-700 transition-all duration-300 rounded-[16px] shadow-sm hover:shadow-md hover:-translate-y-[1px] gap-2"
        style="font-family: Poppins, sans-serif;"
      >
        <svg class="w-4 h-4 fill-current text-slate-600" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M3.609 1.814L13.783 12 3.609 22.186A2.25 2.25 0 0 1 3 20.6V3.4c0-.623.256-1.22.609-1.586zm11.29 9.07L18.423 8.8c.857-.492 1.442-1.42 1.442-2.485s-.585-1.993-1.442-2.486L14.898 1.8C14.04 1.307 13.06 1.307 12.203 1.8L3.926 6.574 13.084 12l9.119 5.426-8.286 4.774a2.235 2.235 0 0 1-2.28 0L3.926 17.426 3 17.962V20.6c0 .623.256 1.22.609 1.586l11.29-9.07z"/>
        </svg>
        Descargar App
      </a>
      <a
        href="https://saneamiento.maiaconsultoresperu.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center border border-[#153f70]/20 bg-white hover:bg-slate-50 active:bg-slate-100 px-5 py-2.5 text-[14px] font-semibold text-[#153f70] transition-all duration-300 rounded-[16px] shadow-sm hover:shadow-md hover:-translate-y-[1px]"
        style="font-family: Poppins, sans-serif;"
      >
        Ingresar al Software
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center bg-[#153f70] px-5 py-2.5 text-[14px] font-semibold text-white transition-all duration-300 hover:bg-[#60e8c1] hover:text-[#153f70] rounded-[16px] shadow-sm shadow-[#153f70]/10 hover:shadow-md hover:-translate-y-[1px]"
        style="font-family: Poppins, sans-serif;"
      >
        Solicitar Demo
      </a>
    </div>

    <!-- Mobile Burger Menu -->
    <div class="flex items-center gap-4 lg:hidden">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center bg-[#153f70] px-4 py-2 text-[13px] font-semibold text-white transition-all duration-300 hover:bg-[#60e8c1] hover:text-[#153f70] rounded-[16px]"
        style="font-family: Poppins, sans-serif;"
      >
        Demo
      </a>
      <button
        id="plagas-mobile-menu-button"
        class="group flex h-10 w-10 flex-col items-center justify-center gap-1.5 focus:outline-none"
        aria-label="Menu"
      >
        <span class="h-0.5 w-6 rounded-full bg-[#1e293b] transition-all duration-300 group-[.open]:translate-y-2 group-[.open]:rotate-45"></span>
        <span class="h-0.5 w-6 rounded-full bg-[#1e293b] transition-all duration-300 group-[.open]:opacity-0"></span>
        <span class="h-0.5 w-6 rounded-full bg-[#1e293b] transition-all duration-300 group-[.open]:-translate-y-2 group-[.open]:-rotate-45"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="plagas-mobile-menu"
    class="invisible absolute left-0 right-0 top-full flex h-0 flex-col overflow-hidden bg-white/95 backdrop-blur-md transition-all duration-500 ease-in-out lg:hidden border-t border-slate-100"
  >
    <nav class="flex flex-col px-6 py-6 divide-y divide-slate-50">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="py-4 text-center text-lg font-medium text-[#334155] transition-colors hover:text-[#153f70]"
            style="font-family: Poppins, sans-serif;"
          >
            {item.label}
          </a>
        ))
      }
      <div class="flex flex-col gap-3 pt-6 pb-4">
        <a
          href="https://play.google.com/store"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center bg-slate-50 border border-slate-200 px-6 py-3.5 text-[15px] font-semibold text-slate-700 transition-all duration-300 rounded-[16px] gap-2"
          style="font-family: Poppins, sans-serif;"
        >
          <svg class="w-4 h-4 fill-current text-slate-600" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.609 1.814L13.783 12 3.609 22.186A2.25 2.25 0 0 1 3 20.6V3.4c0-.623.256-1.22.609-1.586zm11.29 9.07L18.423 8.8c.857-.492 1.442-1.42 1.442-2.485s-.585-1.993-1.442-2.486L14.898 1.8C14.04 1.307 13.06 1.307 12.203 1.8L3.926 6.574 13.084 12l9.119 5.426-8.286 4.774a2.235 2.235 0 0 1-2.28 0L3.926 17.426 3 17.962V20.6c0 .623.256 1.22.609 1.586l11.29-9.07z"/>
          </svg>
          Descargar App
        </a>
        <a
          href="https://app.maiaplagas.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center border border-[#153f70]/20 bg-white px-6 py-3.5 text-[15px] font-semibold text-[#153f70] transition-all duration-300 rounded-[16px]"
          style="font-family: Poppins, sans-serif;"
        >
          Ingresar al Software
        </a>
        <a
          href="#contacto"
          class="flex items-center justify-center bg-[#153f70] px-6 py-3.5 text-[15px] font-semibold text-white transition-all duration-300 rounded-[16px]"
          style="font-family: Poppins, sans-serif;"
        >
          Solicitar Demo
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('plagas-mobile-menu-button');
  const menu = document.getElementById('plagas-mobile-menu');

  button?.addEventListener('click', () => {
    button.classList.toggle('open');
    if (button.classList.contains('open')) {
      menu?.classList.remove('invisible', 'h-0');
      menu?.classList.add('h-screen', 'opacity-100');
      document.body.style.overflow = 'hidden';
    } else {
      menu?.classList.add('h-0');
      menu?.classList.remove('h-screen', 'opacity-100');
      setTimeout(() => {
        if (!button.classList.contains('open')) {
          menu?.classList.add('invisible');
        }
      }, 500);
      document.body.style.overflow = '';
    }
  });

  // Close menu when clicking on links
  const links = menu?.querySelectorAll('a');
  links?.forEach(link => {
    link.addEventListener('click', () => {
      button?.classList.remove('open');
      menu?.classList.add('h-0');
      menu?.classList.remove('h-screen', 'opacity-100');
      setTimeout(() => {
        menu?.classList.add('invisible');
      }, 500);
      document.body.style.overflow = '';
    });
  });
</script>
