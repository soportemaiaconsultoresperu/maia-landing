---
import "@fontsource/poppins/400.css";
import logoMaiaConsultores from "@/assets/images/logo_maia_consultores.png";

const simpleNavItems = [
  { label: "Inicio", href: "/" },
];

const consultoriaDropdown = {
  label: "Consultoría",
  items: [
    { label: "Inocuidad y Calidad", href: "/inocuidad-calidad" },
    { label: "Saneamiento", href: "/saneamiento" },
  ],
};

const softwareDropdown = {
  label: "Software",
  items: [
    { label: "Maia Business", href: "/maiabusiness" },
    { label: "Maia Plagas SaaS", href: "/maiaplagas" },
    { label: "Maia Plagas Licencia", href: "/maiaplagaslicencia" },
    { label: "Maia Residuos", href: "/maiaresiduos" },
  ],
};

const trailingNavItems = [
  { label: "Convertidor", href: "/calculadora" },
  { label: "Contacto", href: "/#contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white shadow-sm">
  <div
    class="mx-auto flex min-h-[120px] w-full max-w-[1344px] items-center px-[20px] sm:px-[45px] lg:h-[120px] lg:px-[45px]"
  >
    <a href="/" aria-label="Maia Consultores" class="shrink-0">
      <img
        src={logoMaiaConsultores.src}
        alt="Maia Consultores"
        class="h-[75px] w-auto sm:h-[90px] md:h-[100px] transition-transform duration-300 hover:scale-105"
      />
    </a>

    <!-- Desktop Nav -->
    <nav
      aria-label="Principal"
      class="ml-auto hidden items-center gap-x-8 lg:flex"
    >
      {/* Simple leading items */}
      {
        simpleNavItems.map((item) => (
          <a
            href={item.href}
            class="text-[17px] font-medium leading-none tracking-tight text-[#111111] transition-all duration-300 hover:text-[#153f70]"
            style="font-family: Poppins, sans-serif;"
          >
            {item.label}
          </a>
        ))
      }

      {/* Consultoría Dropdown */}
      <div class="dropdown-wrapper group relative">
        <button
          type="button"
          class="flex items-center gap-1 text-[17px] font-medium leading-none tracking-tight text-[#111111] transition-all duration-300 hover:text-[#153f70]"
          style="font-family: Poppins, sans-serif;"
        >
          {consultoriaDropdown.label}
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="pointer-events-none absolute left-1/2 top-full z-50 min-w-[220px] -translate-x-1/2 pt-3 opacity-0 transition-all duration-300 group-hover:pointer-events-auto group-hover:opacity-100">
          <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-lg shadow-black/5">
            {
              consultoriaDropdown.items.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-5 py-3 text-[15px] font-medium text-[#333] transition-all duration-200 hover:bg-[#153f70]/5 hover:text-[#153f70]"
                  style="font-family: Poppins, sans-serif;"
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {/* Software Dropdown */}
      <div class="dropdown-wrapper group relative">
        <button
          type="button"
          class="flex items-center gap-1 text-[17px] font-medium leading-none tracking-tight text-[#111111] transition-all duration-300 hover:text-[#153f70]"
          style="font-family: Poppins, sans-serif;"
        >
          {softwareDropdown.label}
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="pointer-events-none absolute left-1/2 top-full z-50 min-w-[220px] -translate-x-1/2 pt-3 opacity-0 transition-all duration-300 group-hover:pointer-events-auto group-hover:opacity-100">
          <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-lg shadow-black/5">
            {
              softwareDropdown.items.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-5 py-3 text-[15px] font-medium text-[#333] transition-all duration-200 hover:bg-[#153f70]/5 hover:text-[#153f70]"
                  style="font-family: Poppins, sans-serif;"
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {/* Simple trailing items */}
      {
        trailingNavItems.map((item) => (
          <a
            href={item.href}
            class="text-[17px] font-medium leading-none tracking-tight text-[#111111] transition-all duration-300 hover:text-[#153f70]"
            style="font-family: Poppins, sans-serif;"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto lg:hidden">
      <button
        id="mobile-menu-button"
        class="group flex h-10 w-10 flex-col items-center justify-center gap-1.5 focus:outline-none"
        aria-label="Menu"
      >
        <span
          class="h-0.5 w-6 rounded-full bg-[#111111] transition-all duration-300 group-[.open]:translate-y-2 group-[.open]:rotate-45"
        ></span>
        <span
          class="h-0.5 w-6 rounded-full bg-[#111111] transition-all duration-300 group-[.open]:opacity-0"
        ></span>
        <span
          class="h-0.5 w-6 rounded-full bg-[#111111] transition-all duration-300 group-[.open]:-translate-y-2 group-[.open]:-rotate-45"
        ></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="invisible absolute left-0 right-0 top-full flex h-0 flex-col overflow-hidden bg-white/95 backdrop-blur-md transition-all duration-500 ease-in-out lg:hidden"
  >
    <nav class="flex flex-col border-t border-gray-100 px-6 py-8">
      {/* Inicio */}
      {
        simpleNavItems.map((item) => (
          <a
            href={item.href}
            class="py-4 text-center text-2xl font-medium text-[#111111] transition-colors hover:text-[#153f70]"
            style="font-family: Poppins, sans-serif;"
          >
            {item.label}
          </a>
        ))
      }

      {/* Mobile Consultoría Accordion */}
      <div class="mobile-accordion">
        <button
          type="button"
          class="mobile-accordion-toggle flex w-full items-center justify-center gap-2 py-4 text-center text-2xl font-medium text-[#111111] transition-colors hover:text-[#153f70]"
          style="font-family: Poppins, sans-serif;"
          data-accordion="consultoria"
        >
          {consultoriaDropdown.label}
          <svg class="accordion-chevron h-5 w-5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="accordion-content hidden flex-col" data-accordion-content="consultoria">
          {
            consultoriaDropdown.items.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="py-3 text-center text-lg font-medium text-[#555] transition-colors hover:text-[#153f70]"
                style="font-family: Poppins, sans-serif;"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      {/* Mobile Software Accordion */}
      <div class="mobile-accordion">
        <button
          type="button"
          class="mobile-accordion-toggle flex w-full items-center justify-center gap-2 py-4 text-center text-2xl font-medium text-[#111111] transition-colors hover:text-[#153f70]"
          style="font-family: Poppins, sans-serif;"
          data-accordion="software"
        >
          {softwareDropdown.label}
          <svg class="accordion-chevron h-5 w-5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="accordion-content hidden flex-col" data-accordion-content="software">
          {
            softwareDropdown.items.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="py-3 text-center text-lg font-medium text-[#555] transition-colors hover:text-[#153f70]"
                style="font-family: Poppins, sans-serif;"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      {/* Trailing items */}
      {
        trailingNavItems.map((item) => (
          <a
            href={item.href}
            class="py-4 text-center text-2xl font-medium text-[#111111] transition-colors hover:text-[#153f70]"
            style="font-family: Poppins, sans-serif;"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    button.classList.toggle("open");
    if (button.classList.contains("open")) {
      menu?.classList.remove("invisible", "h-0");
      menu?.classList.add("h-screen", "opacity-100");
      document.body.style.overflow = "hidden";
    } else {
      menu?.classList.add("h-0");
      menu?.classList.remove("h-screen", "opacity-100");
      setTimeout(() => {
        if (!button.classList.contains("open")) {
          menu?.classList.add("invisible");
        }
      }, 500);
      document.body.style.overflow = "";
    }
  });

  // Close menu when clicking on links (not accordion toggles)
  const links = menu?.querySelectorAll("a");
  links?.forEach((link) => {
    link.addEventListener("click", () => {
      button?.classList.remove("open");
      menu?.classList.add("h-0");
      menu?.classList.remove("h-screen", "opacity-100");
      setTimeout(() => {
        menu?.classList.add("invisible");
      }, 500);
      document.body.style.overflow = "";
    });
  });

  // Mobile accordion toggles
  const accordionToggles = document.querySelectorAll(".mobile-accordion-toggle");
  accordionToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const key = toggle.getAttribute("data-accordion");
      const content = document.querySelector(`[data-accordion-content="${key}"]`);
      const chevron = toggle.querySelector(".accordion-chevron");
      if (content?.classList.contains("hidden")) {
        content.classList.remove("hidden");
        content.classList.add("flex");
        chevron?.classList.add("rotate-180");
      } else {
        content?.classList.add("hidden");
        content?.classList.remove("flex");
        chevron?.classList.remove("rotate-180");
      }
    });
  });
</script>
